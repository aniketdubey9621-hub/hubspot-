# HubSpot app (Auth tab): https://developers.hubspot.com
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must match the redirect URL configured on the HubSpot app (use https in production).
# Vercel: https://YOUR_PROJECT.vercel.app/api/callback
HUBSPOT_REDIRECT_URI=http://127.0.0.1:3001/callback
# Random secret (32+ chars) used to HMAC-sign OAuth state.
HUBSPOT_STATE_SECRET=
# Space-separated scopes — must match what the app requests in HubSpot.
# Every scope checked in the HubSpot app Auth settings must appear here.
HUBSPOT_SCOPES=crm.objects.contacts.read
# Optional: EU data center — use if consent fails on app.hubspot.com for your portal.
# HUBSPOT_OAUTH_AUTHORIZE_URL=https://app-eu1.hubspot.com/oauth/authorize
# Optional: HubSpot `optional_scope` (space-separated) for tiered / add-on features.
# HUBSPOT_OPTIONAL_SCOPES=

# Where /callback redirects after OAuth (your SPA origin, no path).
# Vercel: https://YOUR_PROJECT.vercel.app
FRONTEND_URL=http://127.0.0.1:5173

# Optional: serve built React from this service (single public URL for deploy).
# SERVE_STATIC=true
# CLIENT_DIST_PATH=../client/dist

# Loom / demos: expose token metadata + force-expire without returning secrets.
# DEV_ROUTES_ENABLED=true

PORT=3001
